# No trailing slash: a trailing slash matches directories only, and a node_modules
# SYMLINK (as worktrees use) is a file entry that slips straight past it.
node_modules
dist/
.compaction/
.env
.DS_Store
*.tgz
# Vercel local project-link artifacts (never commit; contains project/org ids)
.vercel/

# Agent worktrees (transient; never commit)
.claude/worktrees/

# Local wrangler state
.wrangler/
__pycache__/
