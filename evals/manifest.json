{
  "schema_version": "1.0.0",
  "updated": "2026-09-05",
  "description": "Public registry for synthetic eval fixtures and content-free A/B harnesses. Engine-backed validation is delivered separately.",
  "eval_gates": {
    "context_preservation": {
      "question": "Was compacted input context recoverable and task-safe per deterministic checks?",
      "used_for": "input_token_reduction_claims"
    },
    "short_but_sufficient": {
      "question": "Does shaped output still satisfy all required task-outcome criteria?",
      "used_for": "output_token_reduction_claims"
    }
  },
  "evals": [
    {
      "id": "recoverability-fixtures",
      "name": "Synthetic recoverability fixtures",
      "proves": [
        "public_fixture_cases_and_expected_labels"
      ],
      "does_not_prove": [
        "engine_evaluator_execution",
        "semantic_preservation",
        "billing_confirmed_savings",
        "token_reduction"
      ],
      "fixtures": [
        "tests/fixtures/eval/"
      ],
      "status": "fixtures_shipped_evaluator_delivered_separately"
    },
    {
      "id": "input-compaction-ab-harness",
      "name": "Input-compaction A/B harness",
      "eval_gate": "context_preservation",
      "proves": [
        "provider_reported_input_ab_n3_se"
      ],
      "does_not_prove": [
        "context_preservation_without_separate_validation",
        "cross_provider_generalization",
        "billing_confirmed_savings"
      ],
      "implementation": [
        "src/core/input-compaction-ab.ts"
      ],
      "cli_commands": [
        "input-compaction-ab init",
        "input-compaction-ab add",
        "input-compaction-ab status"
      ],
      "tests": [
        "tests/core/input-compaction-ab.test.ts"
      ],
      "status": "public_harness_shipped_engine_validation_separate"
    },
    {
      "id": "output-shaping-ab-harness",
      "name": "Output-shaping A/B harness",
      "eval_gate": "short_but_sufficient",
      "proves": [
        "provider_reported_output_ab_n3_se"
      ],
      "does_not_prove": [
        "output_sufficiency_without_separate_validation",
        "single_headline_percent_all_models"
      ],
      "implementation": [
        "src/core/output-shaping-ab.ts",
        "src/core/output-shaping.ts",
        "src/core/output-shaping-attach.ts"
      ],
      "cli_commands": [
        "output-shaping",
        "output-shaping-ab init",
        "output-shaping-ab add",
        "output-shaping-ab status",
        "capture codex --output-shaping",
        "capture cursor --output-shaping"
      ],
      "tests": [
        "tests/core/output-shaping-ab.test.ts",
        "tests/core/output-shaping.test.ts",
        "tests/core/output-shaping-attach.test.ts"
      ],
      "status": "public_harness_shipped_sufficiency_validation_separate"
    },
    {
      "id": "request-input-census-reproducibility-v1",
      "name": "Request input census reproducibility oracle",
      "evidence_type": "synthetic_fixture",
      "proves": [
        "deterministic_reproduction_over_six_fixed_synthetic_fixtures_only"
      ],
      "does_not_prove": [
        "provider_prompt_construction",
        "provider_token_counts",
        "native_provider_runtime_behavior",
        "request_input_reduction",
        "savings",
        "semantic_preservation",
        "generalization_beyond_six_registered_synthetic_fixtures"
      ],
      "implementation": [
        "src/core/request-input-census.ts"
      ],
      "tests": [
        "tests/core/request-input-census.test.ts",
        "tests/core/request-input-census-benchmark.test.ts",
        "tests/security/public-eval-registry-closure.test.ts"
      ],
      "fixtures": [
        "tests/fixtures/request-input-census/anthropic-messages.json",
        "tests/fixtures/request-input-census/openai-chat.json",
        "tests/fixtures/request-input-census/openai-responses-custom-tool-output.json",
        "tests/fixtures/request-input-census/openai-responses-native-discovery.json",
        "tests/fixtures/request-input-census/openai-responses-opaque-result.json",
        "tests/fixtures/request-input-census/openai-responses.json"
      ],
      "artifacts": [
        "evals/request-input-census/benchmark-report-v1.json"
      ],
      "status": "synthetic_fixture_reproducibility_oracle"
    },
    {
      "id": "claims-guards",
      "name": "Public evidence-label guards",
      "proves": [
        "public_copy_within_available_evidence"
      ],
      "tests": [
        "tests/security/open-basic-engine-free.test.ts",
        "tests/cli/watch-tier-label-provenance.test.ts"
      ],
      "docs": [
        "README.md"
      ],
      "status": "shipped"
    }
  ],
  "gaps": [
